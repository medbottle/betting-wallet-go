# Local example values only. No real secrets.
# docker compose reads .env automatically: cp .env.example .env

# --- docker compose: credentials for local containers ---
POSTGRES_PASSWORD=postgres
WALLET_OWNER_PASSWORD=wallet_owner_local
WALLET_APP_PASSWORD=wallet_app_local
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
AWS_REGION=us-east-1

# --- cmd/migrate (schema owner role) ---
MIGRATE_DATABASE_URL=postgres://wallet_owner:wallet_owner_local@localhost:5432/wallet?sslmode=disable

# --- cmd/wallet (application role) ---
# Required.
DATABASE_URL=postgres://wallet_app:wallet_app_local@localhost:5432/wallet?sslmode=disable
DB_MAX_CONNS=10
DB_STARTUP_TIMEOUT=10s
DB_LOCK_TIMEOUT=5s
DB_STATEMENT_TIMEOUT=10s

# OIDC (ARCHITECTURE §11). Required. From the host, the issuer and JWKS
# share localhost:8080; inside compose the JWKS uses keycloak:8080.
OIDC_ISSUER=http://localhost:8080/realms/wagering
OIDC_JWKS_URL=http://localhost:8080/realms/wagering/protocol/openid-connect/certs
OIDC_AUDIENCE=wallet-api
OIDC_JWKS_MIN_REFRESH_INTERVAL=30s

# Test identities provisioned by deploy/keycloak/realm-wagering.json
# (local values only, for client_credentials):
#   provider-a      / provider-a-local-secret       role provider, provider_id=provider-a
#   provider-b      / provider-b-local-secret       role provider, provider_id=provider-b
#   wallet-internal / wallet-internal-local-secret  role wallet-internal

# Reference resolution (ARCHITECTURE §8).
REFERENCE_TTL=10m
REFERENCE_BACKOFF_BASE=1s
REFERENCE_BACKOFF_MAX=60s
REFERENCE_WORKER_CONCURRENCY=4
REFERENCE_WORKER_POLL_INTERVAL=1s

# SQS (ARCHITECTURE §10). From the host the emulator is localhost:4566;
# inside compose it is ministack:4566. Local test credentials only.
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
SQS_EVENTS_QUEUE=wallet-events.fifo
SQS_PUBLISHER_ACCESS_KEY_ID=wallet-publisher
SQS_PUBLISHER_SECRET_ACCESS_KEY=wallet-publisher-local-secret

# Inbound queue, consumer-only credentials and timings (ARCHITECTURE §10/§23).
SQS_INBOUND_QUEUE=wager-transactions.fifo
SQS_INBOUND_DLQ=wager-transactions-dlq.fifo
SQS_CONSUMER_ACCESS_KEY_ID=wallet-consumer
SQS_CONSUMER_SECRET_ACCESS_KEY=wallet-consumer-local-secret
CONSUMER_WAIT_SECONDS=20
CONSUMER_MAX_MESSAGES=10
CONSUMER_HANDLER_TIMEOUT=15s
CONSUMER_BACKOFF_MAX=60s
CONSUMER_PAUSE_INTERVAL=1s

# cmd/dlqredrive (operator credentials; also reads SQS_ENDPOINT, AWS_REGION,
# SQS_INBOUND_QUEUE and SQS_INBOUND_DLQ).
SQS_OPERATOR_ACCESS_KEY_ID=wallet-operator
SQS_OPERATOR_SECRET_ACCESS_KEY=wallet-operator-local-secret

# Outbox relay (ARCHITECTURE §9/§22).
OUTBOX_LEASE=30s
OUTBOX_BATCH_SIZE=10
OUTBOX_PUBLISH_TIMEOUT=5s
OUTBOX_BACKOFF_BASE=1s
OUTBOX_BACKOFF_MAX=5m
OUTBOX_MAX_ATTEMPTS=20
OUTBOX_POLL_INTERVAL=1s
OUTBOX_RELAY_CONCURRENCY=1

HTTP_ADDR=:8081
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_HANDLER_TIMEOUT=10s

READINESS_INTERVAL=2s
READINESS_CHECK_TIMEOUT=1s
READINESS_DRAIN_DELAY=2s

# debug | info | warn | error
LOG_LEVEL=info

# Roles (all on by default). Only RUN_HTTP does something in this slice.
RUN_HTTP=true
RUN_CONSUMER=true
RUN_OUTBOX=true
RUN_REFERENCE_WORKER=true
