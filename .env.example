# Local example values only. No real secrets.
# docker compose reads .env automatically (cp .env.example .env), but only
# for the variables docker-compose.yml interpolates (README, "Local stack");
# the rest applies when the binaries run on the host.

# --- docker compose: credentials for local containers ---
POSTGRES_PASSWORD=postgres
WALLET_OWNER_PASSWORD=wallet_owner_local
WALLET_APP_PASSWORD=wallet_app_local
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
AWS_REGION=us-east-1

# --- cmd/migrate (schema owner role) ---
MIGRATE_DATABASE_URL=postgres://wallet_owner:wallet_owner_local@localhost:5432/wallet?sslmode=disable

# --- cmd/wallet (application role) ---
# Required.
DATABASE_URL=postgres://wallet_app:wallet_app_local@localhost:5432/wallet?sslmode=disable
DB_MAX_CONNS=10
DB_STARTUP_TIMEOUT=10s
DB_LOCK_TIMEOUT=5s
DB_STATEMENT_TIMEOUT=10s

# OIDC (ARCHITECTURE §11). Required. From the host, the issuer and JWKS
# share localhost:8080; inside compose the JWKS uses keycloak:8080.
OIDC_ISSUER=http://localhost:8080/realms/wagering
OIDC_JWKS_URL=http://localhost:8080/realms/wagering/protocol/openid-connect/certs
OIDC_AUDIENCE=wallet-api
OIDC_JWKS_MIN_REFRESH_INTERVAL=30s

# Test identities provisioned by deploy/keycloak/realm-wagering.json
# (local values only, for client_credentials):
#   provider-a      / provider-a-local-secret       role provider, provider_id=provider-a
#   provider-b      / provider-b-local-secret       role provider, provider_id=provider-b
#   wallet-internal / wallet-internal-local-secret  role wallet-internal

# Reference resolution (ARCHITECTURE §8).
REFERENCE_TTL=10m
REFERENCE_BACKOFF_BASE=1s
REFERENCE_BACKOFF_MAX=60s
REFERENCE_WORKER_CONCURRENCY=4
REFERENCE_WORKER_POLL_INTERVAL=1s

# SQS (ARCHITECTURE §10). From the host the emulator is localhost:4566;
# inside compose it is ministack:4566.
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
SQS_EVENTS_QUEUE=wallet-events.fifo
# Broker keys (ARCHITECTURE §28). MiniStack runs with AUTH=true and
# generates every key at startup; its init script writes them to this file
# (copy it out of the container to run the binaries on the host, README
# "Queues"). It fills the publisher, consumer and operator keys that are
# not set. In AWS, set the SQS_*_ACCESS_KEY_ID variables instead, or render
# the same file from a secret store.
SQS_CREDENTIALS_FILE=./deploy/local/sqs-credentials.json
# SQS_PUBLISHER_ACCESS_KEY_ID=
# SQS_PUBLISHER_SECRET_ACCESS_KEY=

# Prometheus metrics listener (ARCHITECTURE §25); empty disables it.
METRICS_ADDR=:9090

# Inbound queue, consumer-only credentials and timings (ARCHITECTURE §10/§23).
SQS_INBOUND_QUEUE=wager-transactions.fifo
SQS_INBOUND_DLQ=wager-transactions-dlq.fifo
# SQS_CONSUMER_ACCESS_KEY_ID=
# SQS_CONSUMER_SECRET_ACCESS_KEY=
# Producer identities the consumer trusts (ARCHITECTURE §10/§11):
# senderId=providerId pairs, and the redrive operator's sender id. The
# sender id is the SenderId SQS reports (in AWS an IAM user or role unique
# id). MiniStack reports the sender's account, and locally each producer
# and the operator send through a role in their own account:
#   provider-a  role wager-producer in 111111111111
#   provider-b  role wager-producer in 222222222222
#   operator    role wager-operator in 333333333333
SQS_PROVIDER_SENDERS=111111111111=provider-a,222222222222=provider-b
SQS_OPERATOR_SENDER_ID=333333333333
CONSUMER_WAIT_SECONDS=20
CONSUMER_MAX_MESSAGES=10
CONSUMER_HANDLER_TIMEOUT=15s
CONSUMER_VISIBILITY_TIMEOUT=60s
CONSUMER_BACKOFF_MAX=60s
CONSUMER_PAUSE_INTERVAL=1s

# cmd/dlqredrive (also reads SQS_ENDPOINT, AWS_REGION, SQS_INBOUND_QUEUE,
# SQS_INBOUND_DLQ, SQS_OPERATOR_SENDER_ID and SQS_CREDENTIALS_FILE, which
# supplies the operator's key and role). The operator's role is in its own
# account, so it finds the queues in their owner's account (000000000000);
# empty in AWS when the operator and the queues share an account.
# SQS_OPERATOR_ACCESS_KEY_ID=
# SQS_OPERATOR_SECRET_ACCESS_KEY=
# SQS_OPERATOR_ROLE_ARN=
SQS_QUEUE_OWNER_ACCOUNT_ID=000000000000

# Outbox relay (ARCHITECTURE §9/§22).
OUTBOX_LEASE=30s
OUTBOX_BATCH_SIZE=10
OUTBOX_PUBLISH_TIMEOUT=5s
OUTBOX_BACKOFF_BASE=1s
OUTBOX_BACKOFF_MAX=5m
OUTBOX_MAX_ATTEMPTS=20
OUTBOX_POLL_INTERVAL=1s
OUTBOX_RELAY_CONCURRENCY=1

HTTP_ADDR=:8081
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_HANDLER_TIMEOUT=10s

READINESS_INTERVAL=2s
READINESS_CHECK_TIMEOUT=1s
READINESS_DRAIN_DELAY=2s

# debug | info | warn | error
LOG_LEVEL=info

# Roles (all on by default); one binary runs any subset (ARCHITECTURE §14).
RUN_HTTP=true
RUN_CONSUMER=true
RUN_OUTBOX=true
RUN_REFERENCE_WORKER=true
